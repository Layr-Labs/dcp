{
  "name": "dcp",
  "schemaVersion": 2,
  "tracks": [
    {
      "benchmarkCommand": [
        "python",
        "dcp_admission.py",
        "finalize",
        "--receipt",
        ".yukon/work/admission.json",
        "--intake",
        ".yukon/work/intake.json",
        "--initial",
        ".yukon/work/initial.json",
        "--initial-review",
        ".yukon/work/review.json",
        "--score",
        ".yukon/score.json",
        "--dossier",
        ".yukon/dossier.json"
      ],
      "category": "math",
      "description": "dcp",
      "direction": "-",
      "editablePaths": [
        "submission"
      ],
      "maxSubmissionBytes": 262144,
      "mode": "pareto",
      "name": "main",
      "objectives": [
        {
          "direction": "-",
          "name": "time_growth"
        }
      ],
      "paretoPolicies": {
        "scoring": {
          "version": "dcp-time-growth-v2"
        },
        "validity": {
          "structured_bounds": "required",
          "version": "dcp-joint-bounds-v7"
        }
      },
      "promotionMode": "manual",
      "runner": {
        "maxConcurrentWorkflows": 2,
        "provider": "github-actions",
        "scoreArtifactName": "dcp-score",
        "workflow": "benchmark.yml"
      },
      "scorePath": ".yukon/score.json",
      "setupCommand": [
        "python",
        "dcp_admission.py",
        "intake",
        "--root",
        ".",
        "--out",
        ".yukon/work/intake.json",
        "--receipt",
        ".yukon/work/admission.json",
        "--score",
        ".yukon/score.json"
      ]
    }
  ]
}
